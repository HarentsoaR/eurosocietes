{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ]
    },
    "perplexity": {
      "type": "remote",
      "url": "https://api.perplexity.ai/mcp",
      "headers": {
        "Authorization": "Bearer {env:PERPLEXITY_API_KEY}"
      }
    }
  }
}