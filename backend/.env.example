# ===================================================================
# EuroSocietes — Laravel API environment
# Copy to .env and adjust. Never commit .env.
# Production values are injected at runtime, not stored here.
# ===================================================================

# -------------------------------------------------------------------
# Application
# -------------------------------------------------------------------
APP_NAME="EuroSocietes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_TIMEZONE=Europe/Paris

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# -------------------------------------------------------------------
# Authentication / Sanctum
# -------------------------------------------------------------------
# Token abilities configuration (admin tokens, editor tokens, etc.)
SANCTUM_TOKEN_PREFIX=eurosocietes_
SANCTUM_TOKEN_EXPIRATION_DAYS=null

# -------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------
# production: stack / daily with JSON for aggregation
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Set LOG_CHANNEL=json to write machine-parseable JSON logs
# (storage/logs/laravel-json.log) for aggregation tools (Loki, ELK, Datadog).
LOG_DAILY_DAYS=14

# -------------------------------------------------------------------
# Database
# -------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=eurosocietes
DB_USERNAME=eurosocietes
DB_PASSWORD=eurosocietes

# Test database (used by phpunit)
DB_DATABASE_TEST=eurosocietes_test

# -------------------------------------------------------------------
# Session / Cache / Queue (Redis)
# -------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=eurosocietes_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# -------------------------------------------------------------------
# Mail
# -------------------------------------------------------------------
# local: log · development: smtp (mailpit/mailhog) · production: ses/smtp
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@eurosocietes.local"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------------------------------------------
# Filesystem / Storage (production: object storage / S3-compatible)
# -------------------------------------------------------------------
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -------------------------------------------------------------------
# Frontend / API consumers (CORS)
# -------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# -------------------------------------------------------------------
# Frontend assets
# -------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
